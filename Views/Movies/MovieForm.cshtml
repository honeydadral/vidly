@model Vidly.ViewModels.MovieFormViewModel
@{
    ViewBag.Title = "New Movie";
}

<h2>New Movie</h2>

@using (Html.BeginForm("Save", "Movies", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @* @Html.AntiForgeryToken() *@

    <div class="form-group">
        @Html.LabelFor(m => m.Movie.Name, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Movie.Name, new { @class = "form-control", placeholder = "Movie name" })
            @Html.ValidationMessageFor(m => m.Movie.Name)
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Movie.ReleaseDate, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Movie.ReleaseDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.Movie.ReleaseDate)
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Movie.NumberInStock, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Movie.NumberInStock, new { @class = "form-control", type = "number", min = "0" })
            @Html.ValidationMessageFor(m => m.Movie.NumberInStock)
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Movie.GenreId, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.DropDownListFor(m => m.Movie.GenreId,
                new SelectList(Model.Genres, "Id", "Name"),
                new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Movie.GenreId)
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Movie.Rating, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Movie.Rating, new { @class = "form-control", placeholder = "e.g. PG-13" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="@Url.Action("Index", "Movies")" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
}